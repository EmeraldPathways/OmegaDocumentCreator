# Omega Document Creator — Environment Variables

# --- Database ---
POSTGRES_DB=omega
POSTGRES_USER=omega
POSTGRES_PASSWORD=omega_dev_password
DATABASE_URL=postgresql+psycopg://omega:omega_dev_password@postgres:5432/omega

# --- File & Backup Storage ---
FILE_STORAGE_PATH=/data/clients
BACKUP_PATH=/data/backups

# --- Session & Security ---
SESSION_SECRET=change-this-session-secret
SESSION_TIMEOUT_MINUTES=30
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# --- App Identity ---
APP_URL=http://office-server.local
ENVIRONMENT=development
REMOTE_ACCESS_MODE=local_only

# --- Remote Access (required when REMOTE_ACCESS_MODE=remote or production) ---
# Comma-separated origins for CORS: https://app.example.com,https://cdn.example.com
CORS_ORIGINS=
# Set to 1 or higher when behind a trusted reverse proxy (nginx, Cloudflare Tunnel, etc.)
TRUSTED_PROXY_COUNT=0

# --- Admin Bootstrap ---
ADMIN_EMAIL=admin@omega.local
ADMIN_PASSWORD=ChangeMe123!
STAFF_EMAIL=staff@omega.local
STAFF_PASSWORD=ChangeMe123!

# --- PDF Converter ---
PDF_CONVERTER_BIN=soffice

# --- Backup/Restore Binaries ---
PG_DUMP_BIN=pg_dump
PG_RESTORE_BIN=pg_restore

# --- Backup Scheduling ---
BACKUP_SCHEDULE_ENABLED=false
BACKUP_SCHEDULE_INTERVAL_MINUTES=1440

# --- AI Settings ---
LOCAL_AI_ENABLED=false
LOCAL_AI_PROVIDER=disabled
LOCAL_AI_MODEL=
LOCAL_AI_EMBEDDING_MODEL=
AI_ENABLED=false
AI_PROVIDER=gemini
AI_API_KEY=
GEMINI_API_KEY=
AI_MODEL=gemini-2.0-flash
AI_TEMPERATURE=0.3

# --- PHI Integration ---
PHI_ENDPOINT_URL=
PHI_USERNAME=
PHI_PASSWORD=
PHI_REQUEST_FROM=
PHI_REQUEST_FROM_CODE=